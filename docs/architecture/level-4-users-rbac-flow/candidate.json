    {
      "dot": "rose",
      "title": "Two-Tier Access Control",
      "items": [
        "Tier 1: RequireRole checks permission.Checker (SuperAdmin & User both have UserRead)",
        "Tier 2: UserPolicy.Scope returns ScopeAll for SuperAdmin and ScopeFiltered(actor.ID) for regular User"
      ]
    },
    {
      "dot": "cyan",
      "title": "Scoped Cache Key & SQL Injection Guard",
      "items": [
        "Cache key embeds actor.Role and actor.ID (users:all:<role>:<id>:...) to prevent cross-tenant cache poisoning",
        "SanitizeSortColumn allow-lists sort columns (id, name, email, created_at, updated_at) before GORM Order()"

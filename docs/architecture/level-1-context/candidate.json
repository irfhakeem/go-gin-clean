      "title": "Actors & Entry",
      "items": [
        "End users register, verify email, log in, rotate refresh tokens, and manage their own profile",
        "Super Admins manage all users under two-tier RBAC + Domain Policy scoping"
      ]
    },
    {
      "dot": "emerald",
      "title": "Data & Caching",
      "items": [
        "PostgreSQL stores users, AES-encrypted refresh tokens, and transactional outbox messages",
        "Redis caches user reads (5m TTL) with graceful fallback to PostgreSQL on cache miss/error"
      ]
    },
    {
      "dot": "amber",
      "title": "External Integrations",
      "items": [
        "RabbitMQ brokers user.register and user.reset_password events with retry + dead-letter queues",
        "SMTP delivers HTML verification/reset emails; Cloudinary stores profile avatars"

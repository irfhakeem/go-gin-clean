  "cards": [
    {
      "dot": "rose",
      "title": "Defense-in-Depth Token Storage",
      "items": [
        "Refresh tokens are signed HS256 JWTs encrypted with AES-256-GCM (random 12-byte nonce) before being stored in cookie and DB",
        "Cookie uses HttpOnly, SameSite=Strict, and automatic Secure flag on HTTPS/ReleaseMode"
      ]
    },
    {
      "dot": "emerald",
      "title": "Atomic Token Rotation",
      "items": [
        "RefreshToken wraps RevokeByToken(txCtx) and Save(txCtx) inside gormTxManager.WithTx",
        "If saving the new refresh token fails, revoking the old token rolls back so the user session is not lost"
      ]
    }
  ]

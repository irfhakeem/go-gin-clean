        "label": "Async Outbox & Consumer Pipeline",
        "focus": ["postgres_container", "outbox_worker", "rabbitmq_container", "consumer_worker", "smtp_relay"],
        "note": "OutboxWorker polls pending rows every 5s with FOR UPDATE SKIP LOCKED, publishes to RabbitMQ, and ConsumerWorker sends SMTP emails."
      }

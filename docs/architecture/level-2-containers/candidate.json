  "cards": [
    {
      "dot": "cyan",
      "title": "Single-Binary Process Model",
      "items": [
        "cmd/server starts Gin HTTP Server, OutboxWorker, ConsumerWorker, and WatchRabbitMQ in coordinated goroutines",
        "Graceful shutdown on SIGINT/SIGTERM drains HTTP traffic before waiting on worker WaitGroup and closing DB/Redis/AMQP"
      ]
    },
    {
      "dot": "emerald",
      "title": "Docker Compose Infrastructure",
      "items": [
        "postgres:16-alpine (:5432), redis:7-alpine (:6379), and rabbitmq:3-management-alpine (:5672/:15672)",
        "cmd/migrate applies versioned plain-SQL DDL migrations (enums, users, refresh_tokens, outbox_messages)"
      ]
    }
  ]

  "cards": [
    {
      "dot": "emerald",
      "title": "Atomic User + Outbox Write",
      "items": [
        "gormTxManager.WithTx injects *gorm.DB into txCtx via activeTxKey",
        "userRepo.Create(txCtx) and outboxRepo.Create(txCtx) share one Postgres transaction; if outbox insert fails, user creation rolls back"
      ]
    },
    {
      "dot": "amber",
      "title": "At-Least-Once Outbox Relay",
      "items": [
        "OutboxWorker ticks every 5s and locks up to 10 pending rows with FOR UPDATE SKIP LOCKED",
        "ConsumerWorker consumes user.register with QoS=1, retries 4xx SMTP errors via .retry queue, and routes permanent failures to .dead"
      ]
    }
  ]

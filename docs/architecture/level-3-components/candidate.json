  "cards": [
    {
      "dot": "violet",
      "title": "Inversion of Control (Clean Architecture)",
      "items": [
        "Repository (internal/domain/repository) and gateway (internal/domain/gateway) contracts live in the Domain layer",
        "Use cases (internal/usecase) orchestrate domain rules and call domain contracts; infrastructure implements them",
        "internal/app.go wires infrastructure into use cases and use cases into delivery handlers via constructor injection"
      ]
    },
    {
      "dot": "rose",
      "title": "Two-Tier Authorization",
      "items": [
        "Tier 1 (Inbound Middleware): RequireRole checks coarse role permissions via permission.Checker",
        "Tier 2 (Application + Domain): UserUseCase calls policy.UserPolicy.Scope(actor, action) for row-level scoping"
      ]
    },
    {
      "dot": "emerald",
      "title": "Context-Propagated Transactions",
      "items": [
        "gormTxManager.WithTx injects *gorm.DB into context (activeTxKey)",
        "getTx(ctx, r.db) in BaseRepository, UserRepo, RefreshTokenRepo, and OutboxRepo automatically joins active transactions"
      ]
    }
  ]

      {
        "id": "user_rbac_slice",
        "label": "User Management & RBAC Policy Slice",
        "focus": ["http_middleware", "http_handlers", "user_usecase", "domain_rbac_policy", "postgres_repos", "cache_storage_adapters"],
        "note": "RequireRole enforces coarse RBAC at the route edge; UserUseCase enforces UserPolicy data scoping and Redis cache-aside."
      },
      {
        "id": "async_outbox_slice",
        "label": "Transactional Outbox & Email Slice",
        "focus": ["auth_usecase", "outbox_email_uc", "mq_handlers", "postgres_repos", "mq_smtp_adapters"],
        "note": "AuthUseCase writes outbox rows in-transaction; OutboxUseCase publishes to RabbitMQ and EmailEventHandler triggers SMTP delivery."
      }
    ]
